# SubMate configuration (non-secret).
#
# There is no authentication secret here: the local passphrase is stored as a
# salted hash inside the SQLite database, not in the environment.
#
# SubMate reads these from the process environment. To load a local .env file,
# start the app with Node's built-in flag, e.g.:
#   node --env-file=.env server/index.js

# --- Storage ---
# Directory that holds the SQLite database (default: ./data).
SUBMATE_DATA_DIR=
# Explicit database file path (overrides SUBMATE_DATA_DIR).
SUBMATE_DB_PATH=
# Backup directory (default: <data dir>/backups) and retention count (0 = keep all).
SUBMATE_BACKUP_DIR=
SUBMATE_BACKUP_KEEP=7

# --- HTTP listener ---
# Defaults: SUBMATE_PORT/PORT = 3001, HOST = 127.0.0.1.
# On a host/container set HOST=0.0.0.0 so the platform can reach the app.
SUBMATE_PORT=
PORT=
HOST=

# --- Runtime ---
# Set to "production" when deployed. This adds the Secure flag to the session cookie.
NODE_ENV=
